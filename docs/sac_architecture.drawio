        <mxCell id="1202" edge="1" parent="1" source="1102" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;dashed=0;startArrow=none;endArrow=classic;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" target="1103" value="Lectura de vértices">
          <mxGeometry relative="1" as="geometry" />
