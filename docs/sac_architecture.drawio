<mxfile host="Electron" agent="Antigravity Agent">
  <diagram id="sac_architecture_phase5" name="SAC Residual Architecture Phase 5">
    <mxGraphModel dx="3214" dy="841" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="100" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#F8FAFC;fontStyle=1;fontSize=18;align=center;verticalAlign=middle;shadow=1;strokeWidth=2;" value="&lt;b&gt;ARQUITECTURA SAC RESIDUAL &amp; CURRICULUM RL — FASE 5&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:12px;font-weight:normal;color:#94A3B8;&#39;&gt;Doblado Dinámico de Ropa en Génesis World (XPBD) | Soft Actor-Critic Continuo (22D Obs → 3D Residual Act) | Gestor de Fricción Adaptativo&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1680" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="1000" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fillColor=#F0FDFA;strokeColor=#0D9488;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#0F766E;spacingTop=12;dashed=0;shadow=0;" value="&lt;b&gt;SUBSISTEMA 1: ENTORNO GYMNASIUM &amp; FÍSICA GENESIS XPBD&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;font-size:10px;font-weight:normal;color:#0F766E;&#39;&gt;DynamicFoldingEnv &amp; ClothGenesisBackend&lt;/span&gt;" vertex="1">
          <mxGeometry height="920" width="480" x="40" y="100" as="geometry" />
        </mxCell>
        <mxCell id="1101" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#1E293B;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=4;shadow=0;" value="&lt;b&gt;Simulador Físico: Genesis World (v1.4.0 / 0.3.13)&lt;/b&gt;&lt;br&gt;• Backend: GPU (Taichi JIT / CUDA)&lt;br&gt;• Solver de Partículas: XPBD (&lt;tt&gt;gs.materials.PBD.Cloth&lt;/tt&gt;)&lt;br&gt;• Timestep: &amp;Delta;t = 0.004 s (250 Hz) | Substeps: 6 &amp;ndash; 12&lt;br&gt;• Iteraciones: Stretch=10, Bending=10 | Tamaño partícula = 8 mm&lt;br&gt;• Entornos Paralelos: N&lt;sub&gt;envs&lt;/sub&gt; = 4 (Grilla 2x2, &gt;120 FPS combinados)" vertex="1">
          <mxGeometry height="95" width="440" x="60" y="170" as="geometry" />
        </mxCell>
        <mxCell id="1102" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14B8A6;fontColor=#1E293B;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=4;shadow=0;" value="&lt;b&gt;Prenda Deformable &amp; Puntos Semánticos&lt;/b&gt;&lt;br&gt;• Malla OBJ: Pantalón FoldNet (430) / ClothesNet (PS_004)&lt;br&gt;• Topología: ~4.500 partículas deformables XPBD&lt;br&gt;• 7 Keypoints Anatómicos Canónicos:&lt;br&gt;  &lt;tt&gt;[l_corner, r_corner, crotch, top_ctr_f, top_ctr_b, l_leg_o, r_leg_o]&lt;/tt&gt;&lt;br&gt;• Coordenadas Métricas 3D en Sistema de Coordenadas Local del Entorno" vertex="1">
          <mxGeometry height="85" width="440" x="60" y="280" as="geometry" />
        </mxCell>
        <mxCell id="1103" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#1E293B;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=4;shadow=0;" value="&lt;b&gt;Extractor del Vector de Observación (s&lt;sub&gt;t&lt;/sub&gt; &amp;isin; &amp;real;&lt;sup&gt;22&lt;/sup&gt;)&lt;/b&gt;&lt;br&gt;• 7 Puntos Clave &amp;times; Posición 3D (x, y, z) = &lt;b&gt;21 dimensiones&lt;/b&gt;&lt;br&gt;• Progreso Temporal Normalizado: &lt;b&gt;&amp;tau; = t / T &amp;isin; [0.0, 1.0]&lt;/b&gt; (1 dimensión)&lt;br&gt;• Dimensión Total: &lt;b&gt;s&lt;sub&gt;t&lt;/sub&gt; = [p&lt;sub&gt;1&lt;/sub&gt;, ..., p&lt;sub&gt;7&lt;/sub&gt;, &amp;tau;] &amp;isin; &amp;real;&lt;sup&gt;22&lt;/sup&gt;&lt;/b&gt; (o [B, 22] en multi-env)&lt;br&gt;• Validación: Cero NaNs, coordenadas locales invariantes al offset de grilla" vertex="1">
          <mxGeometry height="85" width="440" x="60" y="395" as="geometry" />
        </mxCell>
        <mxCell id="1104" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#1E293B;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=4;shadow=0;" value="&lt;b&gt;Generador de Trayectoria Nominal de Bézier (C&lt;sup&gt;2&lt;/sup&gt; Quintic)&lt;/b&gt;&lt;br&gt;• Ley Temporal de Mínimo Tirón: s(&amp;tau;) = 10&amp;tau;&lt;sup&gt;3&lt;/sup&gt; - 15&amp;tau;&lt;sup&gt;4&lt;/sup&gt; + 6&amp;tau;&lt;sup&gt;5&lt;/sup&gt;&lt;br&gt;• Elevación Parabólica: &amp;Aacute;pice h = h&lt;sub&gt;ratio&lt;/sub&gt; &amp;middot; ||P&lt;sub&gt;target&lt;/sub&gt; - P&lt;sub&gt;0&lt;/sub&gt;|| (h&lt;sub&gt;ratio&lt;/sub&gt;=0.65)&lt;br&gt;• Posición Analítica Suave: &lt;b&gt;x&lt;sub&gt;nominal&lt;/sub&gt;(&amp;tau;) &amp;isin; &amp;real;&lt;sup&gt;3&lt;/sup&gt;&lt;/b&gt;&lt;br&gt;• Propósito: Guiar el doblado macro libre de inestabilidades cinemáticas" vertex="1">
          <mxGeometry height="85" width="440" x="60" y="510" as="geometry" />
        </mxCell>
        <mxCell id="1105" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#1E293B;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=4;shadow=0;" value="&lt;b&gt;Mezclador de Acción Residual (Fusión Cinemática)&lt;/b&gt;&lt;br&gt;• Acción de la Política SAC: &lt;b&gt;a&lt;sub&gt;t&lt;/sub&gt; &amp;isin; [-0.03, +0.03] m&lt;/b&gt; (&amp;plusmn;3 cm)&lt;br&gt;• Comando Cinemático Final: &lt;b&gt;x&lt;sub&gt;cmd&lt;/sub&gt; = x&lt;sub&gt;nominal&lt;/sub&gt;(&amp;tau;) + a&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;• Clamping de Seguridad: np.clip(a&lt;sub&gt;t&lt;/sub&gt;, -0.03, 0.03)&lt;br&gt;• Mecanismo de Control: Desplazamiento rígido acoplado a parche PBD" vertex="1">
          <mxGeometry height="80" width="440" x="60" y="625" as="geometry" />
        </mxCell>
        <mxCell id="1106" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;fontColor=#1E293B;fontStyle=0;fontSize=11;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=4;shadow=0;" value="&lt;b&gt;Paso de Integración Cinemática (ClothGenesisBackend)&lt;/b&gt;&lt;br&gt;• Parche activo anclado: partículas fijas r&lt;sub&gt;grasp&lt;/sub&gt; = 20 mm&lt;br&gt;• Actualización continua C&lt;sup&gt;1&lt;/sup&gt;: set_particles_pos(x&lt;sub&gt;cmd&lt;/sub&gt; + offset)&lt;br&gt;• Integración XPBD: scene.step() &amp;times; substeps (sin violar tensiones)" vertex="1">
          <mxGeometry height="65" width="440" x="60" y="735" as="geometry" />
        </mxCell>
        <mxCell id="1107" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#1E293B;fontStyle=1;fontSize=11;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=4;shadow=0;" value="&lt;b&gt;Función de Recompensa Cóncava (Li et al., 2025)&lt;/b&gt;&lt;br&gt;• Distancia Euclídea: d = ||p&lt;sub&gt;activo&lt;/sub&gt; - p&lt;sub&gt;target&lt;/sub&gt;||&lt;br&gt;• Normalización: d&lt;sub&gt;norm&lt;/sub&gt; = d / (&amp;delta;&lt;sub&gt;threshold&lt;/sub&gt; + 10&lt;sup&gt;-7&lt;/sup&gt;), con &amp;delta; = 0.05 m&lt;br&gt;• &lt;b&gt;R(s, a) = 1.0 - (d&lt;sub&gt;norm&lt;/sub&gt;)&lt;sup&gt;0.4&lt;/sup&gt;&lt;/b&gt; &amp;nbsp;si d &amp;le; &amp;delta;, sino &lt;b&gt;-1.0&lt;/b&gt;&lt;br&gt;• Término: Truncado a horizonte H=20 pasos | Release &amp; Settle: 40 steps" vertex="1">
          <mxGeometry height="80" width="440" x="60" y="830" as="geometry" />
        </mxCell>
        <mxCell id="1201" edge="1" parent="1" source="1101" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0D9488;strokeWidth=2;dashed=0;startArrow=none;endArrow=classic;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" target="1102" value="">
          <mxGeometry relative="1" as="geometry" />
