        <mxCell id="1203" edge="1" parent="1" source="1103" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8B5CF6;strokeWidth=2;dashed=0;startArrow=none;endArrow=classic;fontSize=10;fontColor=#334155;labelBackgroundColor=#FFFFFF;" target="1104" value="Progreso &amp;tau;">
          <mxGeometry relative="1" as="geometry" />
